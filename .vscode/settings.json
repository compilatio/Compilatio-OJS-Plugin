{
    "intelephense.files.associations": [
        "*.php",
        "*.phtml"
    ],
    "intelephense.environment.includePaths": [
        "/ojs-3.5.0-4",
    ],
    "intelephense.environment.exclude": [
        "/.old/",
    ],
    "php.validate.enable": true,
    /* PHP version pour Intelephense */
    "intelephense.environment.phpVersion": "8.1",
    /* PHP lint basique */
    "php.validate.executablePath": "/usr/bin/php",
    "phpsab.fixerArguments": [],
    "phpsab.snifferEnable": true,
    "phpsab.fixerEnable": true,
    "phpsab.executablePathCS": "/home/sites/.config/composer/vendor/bin/phpcs",
    "phpsab.executablePathCBF": "/home/sites/.config/composer/vendor/bin/phpcbf",
    "phpsab.standard": "moodle",
    "phpsab.snifferMode": "onSave",
    "[php]": {
        "editor.defaultFormatter": "valeryanm.vscode-phpsab",
        "editor.formatOnSave": true
    }
}